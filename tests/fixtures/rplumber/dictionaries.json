      "indicator": "LAP_2GDP_NOC_RT",
      "indicator.label": "Labour income share as a percent of GDP -- ILO modelled estimates, Nov. 2025 (%)",
      "indicator.description": "The labour income share in GDP is the ratio, in percentage, between total labour income and gross domestic product."
    },
    {
      "indicator": "LAP_2LID_QTL_RT",
      "indicator.label": "Labour income distribution by decile -- ILO modelled estimates, Sept. 2025 (%)",
      "indicator.description": "This indicator shows in percentage the share of total labour income that accrues to each decile. For more information, refer to the <a href=\"https://ilostat.ilo.org/methods/concepts-and-definitions/ilo-modelled-estimates/\">ILO Modelled Estimates (ILOEST) database description</a>.</p>"
    },
    {
      "indicator": "POP_2POP_SEX_NB",
      "indicator.label": "Population by sex -- UN estimates and projections, July 2024 (thousands)",
      "indicator.description": "The total population comprises persons of all ages living in the country. The source is the United Nations' <i>World Population Prospects</i>. For more information, refer to the <a href=\"https://ilostat.ilo.org/methods/concepts-and-definitions/ilo-modelled-estimates/\">ILO Modelled Estimates (ILOEST) database description</a>.</p>"
    },
    {
      "indicator": "SDG_0552_NOC_RT",
      "indicator.label": "SDG indicator 5.5.2: Proportion of women in senior and middle management positions (%)",
      "indicator.description": "<strong>Data may differ from nationally reported figures and the Global SDG Indicators Database.</strong> The female share of employment in managerial positions conveys the number of women in management as a percentage of employment in management."
    },
    {
      "indicator": "UNE_2EAP_SEX_AGE_RT",
      "indicator.label": "Unemployment rate by sex and age -- ILO modelled estimates, Nov. 2025 (%)",
      "indicator.description": "<strong>Imputed observations are not based on national data, are subject to high uncertainty and should not be used for country comparisons or rankings. </strong>The unemployment rate conveys the number of persons who are unemployed as a percent of the labour force."
    },
    {
      "indicator": "UNE_DEAP_SEX_AGE_RT",
      "indicator.label": "Unemployment rate by sex and age (%)",
      "indicator.description": "<strong>With the aim of promoting international comparability, statistics presented on ILOSTAT are based on standard international definitions wherever feasible and may differ from official national figures. </strong>The unemployment rate conveys the number of persons who are unemployed as a percent of the labour force. For more information, refer to the <a href = \"https://ilostat.ilo.org/methods/concepts-and-definitions/description-labour-force-statistics/\">Labour Force Statistics (LFS and STLFS) database description</a>."
